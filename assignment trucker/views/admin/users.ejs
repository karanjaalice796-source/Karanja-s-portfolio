<%- include('../partials/header', { title: title }) %>
<section class="page-heading"><div><p class="eyebrow">Centre administration</p><h1>People</h1><p class="muted">Manage student, trainer and administrator access.</p></div><a class="button primary" href="/admin/users/new">Add a person</a></section>
<form class="filter-bar" method="get" action="/admin/users"><label>Role<select name="role"><option value="">All roles</option><% ['student','teacher','admin'].forEach(function(r) { %><option value="<%= r %>" <%= role === r ? 'selected' : '' %>><%= r %></option><% }) %></select></label><label class="search-label">Search<input type="search" name="q" value="<%= q %>" placeholder="Name, email or student ID"></label><button class="button secondary" type="submit">Filter</button></form>
<section class="section-block"><div class="table-wrap"><table><thead><tr><th>Name</th><th>Role</th><th>Email / Student ID</th><th>Access</th><th>Actions</th></tr></thead><tbody><% users.forEach(function(person) { %><tr><td><strong><%= person.full_name %></strong></td><td><span class="pill neutral"><%= person.role %></span></td><td><%= person.email %><% if (person.student_no) { %><small><%= person.student_no %></small><% } %></td><td><span class="status-dot <%= person.approved && person.active ? 'enabled' : '' %>"><%= person.role === 'teacher' && !person.approved ? 'Pending approval' : person.active ? 'Active' : 'Disabled' %></span></td><td class="table-actions"><% if (person.role === 'teacher' && !person.approved) { %><form method="post" action="/admin/users/<%= person.id %>/approve"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="text-button" type="submit">Approve trainer</button></form><% } else { %><form method="post" action="/admin/users/<%= person.id %>/toggle"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="text-button" type="submit" <%= person.id === user.id ? 'disabled title="You cannot disable your own account"' : '' %>><%= person.active ? 'Disable' : 'Enable' %></button></form><% } %><form class="password-reset" method="post" action="/admin/users/<%= person.id %>/password"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label class="visually-hidden" for="password-<%= person.id %>">New password for <%= person.full_name %></label><input id="password-<%= person.id %>" name="password" type="password" minlength="8" placeholder="New password" required><button class="text-button" type="submit">Set password</button></form></td></tr><% }) %></tbody></table></div><% if (!users.length) { %><div class="empty-state"><h3>No matching people</h3><p>Try a different search or add a person.</p></div><% } %></section>
<%- include('../partials/footer') %>