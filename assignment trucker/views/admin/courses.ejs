<%- include('../partials/header', { title: title }) %>
<section class="page-heading"><div><p class="eyebrow">Centre administration</p><h1>Courses</h1><p class="muted">Set up course spaces and assign a trainer.</p></div></section>
<section class="form-panel course-create"><div><p class="eyebrow">New course</p><h2>Add a course</h2></div><form class="inline-form" method="post" action="/admin/courses"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Course name<input name="name" required maxlength="80" placeholder="Web Development"></label><label>Course code<input name="code" maxlength="20" placeholder="WEB101"></label><label>Trainer<select name="teacher_id"><option value="">Not assigned</option><% teachers.forEach(function(teacher) { %><option value="<%= teacher.id %>"><%= teacher.full_name %></option><% }) %></select></label><button class="button primary" type="submit">Add course</button></form></section>
<section class="section-block"><div class="section-title"><div><p class="eyebrow">Teaching spaces</p><h2><%= courses.length %> course<%= courses.length === 1 ? '' : 's' %></h2></div></div>
<% if (courses.length) { %><div class="table-wrap"><table><thead><tr><th>Course</th><th>Trainer</th><th>Students</th><th>Assignments</th><th></th></tr></thead><tbody><% courses.forEach(function(course) { %><tr><td><strong><%= course.name %></strong><% if (course.code) { %><small><%= course.code %></small><% } %></td><td><form class="inline-form compact-form" method="post" action="/admin/courses/<%= course.id %>/teacher"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><select name="teacher_id"><option value="">Unassigned</option><% teachers.forEach(function(teacher) { %><option value="<%= teacher.id %>" <%= course.teacher_id === teacher.id ? 'selected' : '' %>><%= teacher.full_name %></option><% }) %></select><button class="text-button" type="submit">Save</button></form></td><td><%= course.students %></td><td><%= course.assignments %></td><td><form method="post" action="/admin/courses/<%= course.id %>/delete" onsubmit="return confirm('Delete this course and its assignments?')"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="text-button danger-text" type="submit">Delete</button></form></td></tr><% }) %></tbody></table></div><% } else { %><div class="empty-state"><h3>No courses yet</h3><p>Add a course above, then assign a trainer and enroll students.</p></div><% } %></section>
<%- include('../partials/footer') %>