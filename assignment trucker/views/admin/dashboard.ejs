<%- include('../partials/header', { title: title }) %>
<section class="page-heading"><div><p class="eyebrow">Centre administration</p><h1>Overview</h1><p class="muted">A current snapshot of accounts, courses and work in the centre.</p></div><a class="button primary" href="/admin/users/new">Add a person</a></section>
<section class="stat-strip"><div><strong><%= stats.students %></strong><span>Active students</span></div><div><strong><%= stats.teachers %></strong><span>Active trainers</span></div><div><strong><%= stats.courses %></strong><span>Courses</span></div><div><strong><%= stats.assignments %></strong><span>Assignments</span></div><div class="attention"><strong><%= stats.overdue %></strong><span>Late hand-ins</span></div></section>
<section class="section-block"><div class="section-title"><div><p class="eyebrow">Recently joined</p><h2>People</h2></div><a class="text-link" href="/admin/users">Manage people →</a></div>
<% if (recent.length) { %><div class="table-wrap"><table><thead><tr><th>Name</th><th>Role</th><th>Email</th><th>Joined</th></tr></thead><tbody><% recent.forEach(function(person) { %><tr><td><strong><%= person.full_name %></strong></td><td><span class="pill neutral"><%= person.role %></span></td><td><%= person.email %></td><td><%= fmt.pretty(person.created_at) %></td></tr><% }) %></tbody></table></div><% } else { %><p class="muted">No accounts yet.</p><% } %></section>
<section class="section-block admin-shortcuts"><a href="/admin/users"><span>01</span><div><strong>People</strong><small>Add accounts, disable access, or set a new password.</small></div><b>→</b></a><a href="/admin/courses"><span>02</span><div><strong>Courses</strong><small>Create courses and assign trainers.</small></div><b>→</b></a></section>
<%- include('../partials/footer') %>