<%- include('../partials/header', { title: title }) %>
<section class="page-heading"><div><p class="eyebrow">Centre administration</p><h1>Overview</h1><p class="muted">A current snapshot of accounts, courses and work in the centre.</p></div><a class="button primary" href="/admin/users/new">Add a person</a></section>
<nav class="dashboard-tabs" aria-label="Administration dashboard categories"><a href="#overview">Overview</a><a href="#people">People</a><a href="#courses">Courses</a></nav>
<section class="dashboard-category" id="overview"><div class="section-title"><div><p class="eyebrow">Centre activity</p><h2>At a glance</h2></div></div><section class="stat-strip"><div><strong><%= stats.students %></strong><span>Active students</span></div><div><strong><%= stats.teachers %></strong><span>Active trainers</span></div><div><strong><%= stats.courses %></strong><span>Courses</span></div><div><strong><%= stats.assignments %></strong><span>Assignments</span></div><div class="attention"><strong><%= stats.overdue %></strong><span>Late hand-ins</span></div></section></section>
<section class="dashboard-category section-block" id="people"><div class="section-title"><div><p class="eyebrow">Accounts</p><h2>Recently joined</h2></div><a class="text-link" href="/admin/users">Manage people</a></div>
<% if (recent.length) { %><div class="table-wrap"><table><thead><tr><th>Name</th><th>Role</th><th>Email</th><th>Joined</th></tr></thead><tbody><% recent.forEach(function(person) { %><tr><td><strong><%= person.full_name %></strong></td><td><span class="pill neutral"><%= person.role %></span></td><td><%= person.email %></td><td><%= fmt.pretty(person.created_at) %></td></tr><% }) %></tbody></table></div><% } else { %><p class="muted">No accounts yet.</p><% } %></section>
<section class="dashboard-category section-block" id="courses"><div class="section-title"><div><p class="eyebrow">Learning programme</p><h2>Courses</h2></div></div><div class="admin-shortcuts"><a href="/admin/courses"><span>02</span><div><strong>Manage courses</strong><small>Create courses, assign trainers and review enrolment.</small></div><b>→</b></a></div></section>
<%- include('../partials/footer') %>