<%- include('../partials/header', { title: title }) %>
<p class="breadcrumb"><a href="/student">My assignments</a> / Assignment</p>
<section class="detail-heading"><div><p class="eyebrow"><%= a.course_name %><%= personal ? ' · Personal task' : '' %></p><h1><%= a.title %></h1><p class="muted"><%= a.description || 'No additional notes.' %></p></div><span class="pill <%= a.submitted ? 'green' : a.state === 'late' ? 'red' : a.status === 'In Progress' ? 'blue' : 'gold' %>"><%= a.submitted ? 'Handed in' : a.status %></span></section>
<section class="detail-grid"><div class="detail-panel"><h2>Deadline</h2><p class="detail-date"><%= fmt.pretty(a.due_on) %></p><p class="muted"><%= a.submitted ? 'Submitted ' + fmt.pretty(a.submitted_at) : a.state === 'late' ? 'Overdue by ' + Math.abs(a.days) + ' days' : a.days === 0 ? 'Due today' : 'Due in ' + a.days + ' days' %></p><% if (a.max_marks) { %><p>Worth <strong><%= a.max_marks %></strong> marks</p><% } %><% if (a.marks !== null && a.marks !== undefined) { %><p>Mark: <strong><%= a.marks %><%= a.max_marks ? ' / ' + a.max_marks : '' %></strong></p><% } %><% if (a.feedback) { %><h3>Trainer feedback</h3><p><%= a.feedback %></p><% } %></div>
<div class="detail-panel"><h2>Progress</h2><% if (personal) { %><form method="post" action="/student/assignments/<%= a.id %>/progress"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Status<select name="status"><% statuses.forEach(function(status) { %><option <%= a.status === status ? 'selected' : '' %>><%= status %></option><% }) %></select></label><button class="button secondary" type="submit">Save progress</button></form><p class="form-foot"><a href="/student/tasks/<%= a.id %>/edit">Edit this personal task</a></p><% } else if (!a.submitted) { %><form class="stack-form" method="post" action="/student/assignments/<%= a.id %>/progress"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Progress<select name="status"><option <%= a.status === 'Not Started' ? 'selected' : '' %>>Not Started</option><option <%= a.status === 'In Progress' ? 'selected' : '' %>>In Progress</option></select></label><button class="button secondary" type="submit">Update progress</button></form><% } else { %><p>This assignment has been handed in.</p><% } %></div></section>
<% if (!personal && !a.submitted) { %><section class="form-panel handin-panel"><h2>Hand in your work</h2><p class="muted">Paste a link or add a short note about where your trainer can find the work.</p><form class="stack-form" method="post" action="/student/assignments/<%= a.id %>/submit"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Work link or note<textarea name="work_note" rows="4" maxlength="500" required></textarea></label><button class="button primary" type="submit">Hand in assignment</button></form></section><% } else if (a.work_note) { %><section class="detail-panel handin-panel"><h2>Your hand-in</h2><p class="long-text"><%= a.work_note %></p></section><% } %>
<%- include('../partials/footer') %>