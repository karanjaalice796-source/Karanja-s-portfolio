<%- include('../partials/header', { title: title }) %>
<section class="page-heading"><div><p class="eyebrow">Student workspace</p><h1>My assignments</h1><p class="muted">Your course work and personal tasks, ordered around the next deadline.</p></div><a class="button primary" href="/student/tasks/new">Add personal task</a></section>
<section class="stat-strip" aria-label="Assignment summary"><div><strong><%= summary.open %></strong><span>Open</span></div><div><strong><%= summary.week %></strong><span>Due in 7 days</span></div><div><strong><%= summary.late %></strong><span>Overdue</span></div><div><strong><%= summary.done %></strong><span>Handed in</span></div></section>
<% if (notes.length) { %><section class="notice-list"><div class="section-title"><h2>Updates from your centre</h2><form method="post" action="/student/notifications/read"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="text-button" type="submit">Mark all read</button></form></div><ul><% notes.forEach(function(note) { %><li><%= note.message %><small><%= fmt.pretty(note.created_at) %></small></li><% }) %></ul></section><% } %>
<% if (alerts.length) { %><section class="deadline-alert <%= alerts.some(function(a) { return a.state === 'late'; }) ? 'danger' : '' %>"><strong><%= alerts.some(function(a) { return a.state === 'late'; }) ? 'Deadlines need attention' : 'Coming up soon' %></strong><ul><% alerts.forEach(function(a) { %><li><a href="/student/assignments/<%= a.id %>"><%= a.title %></a> · <%= a.course_name %> · <%= a.state === 'late' ? 'Overdue by ' + Math.abs(a.days) + ' days' : (a.days === 0 ? 'Due today' : 'Due in ' + a.days + ' days') %></li><% }) %></ul></section><% } %>
<section class="list-section">
  <div class="section-title"><div><p class="eyebrow">Your workload</p><h2><%= totalCount %> assignment<%= totalCount === 1 ? '' : 's' %></h2></div><a class="text-link" href="/student/export.csv">Download CSV</a></div>
  <form class="filter-bar" method="get" action="/student">
    <label>Show<select name="filter"><% [['open','Open'],['overdue','Overdue'],['completed','Handed in'],['all','All']].forEach(function(option) { %><option value="<%= option[0] %>" <%= filter === option[0] ? 'selected' : '' %>><%= option[1] %></option><% }) %></select></label>
    <label>Course<select name="course"><option value="">All courses</option><% courses.forEach(function(name) { %><option value="<%= name %>" <%= course === name ? 'selected' : '' %>><%= name %></option><% }) %></select></label>
    <label>Sort<select name="sort"><option value="due" <%= sort === 'due' ? 'selected' : '' %>>Due date</option><option value="course" <%= sort === 'course' ? 'selected' : '' %>>Course</option><option value="status" <%= sort === 'status' ? 'selected' : '' %>>Progress</option></select></label>
    <label class="search-label">Search<input type="search" name="q" value="<%= q %>" placeholder="Title, course or note"></label>
    <button class="button secondary" type="submit">Apply</button>
  </form>
  <% if (rows.length) { %><div class="assignment-list"><% rows.forEach(function(a) { %>
    <article class="assignment-row <%= a.state %>"><div class="assignment-main"><a class="assignment-title" href="/student/assignments/<%= a.id %>"><%= a.title %></a><span class="course-label"><%= a.course_name %><%= a.owner_id ? ' · Personal task' : '' %></span><% if (a.description) { %><p><%= a.description %></p><% } %></div><div class="date-cell"><strong><%= fmt.pretty(a.due_on) %></strong><span class="state-label"><%= a.submitted ? 'Handed in' : a.state === 'late' ? 'Overdue by ' + Math.abs(a.days) + ' days' : a.days === 0 ? 'Due today' : a.days === 1 ? 'Due tomorrow' : 'Due in ' + a.days + ' days' %></span></div><div class="progress-cell"><span class="pill <%= a.submitted ? 'green' : a.status === 'In Progress' ? 'blue' : 'gold' %>"><%= a.status || 'Not Started' %></span><% if (a.submitted) { %><small>Submitted</small><% } %></div><a class="row-arrow" href="/student/assignments/<%= a.id %>" aria-label="Open <%= a.title %>">View <span aria-hidden="true">→</span></a></article>
  <% }) %></div><% } else { %><div class="empty-state"><h3><%= totalCount ? 'No assignments match these filters.' : 'Your list starts here.' %></h3><p><%= totalCount ? 'Try changing the filters or search.' : 'Assignments from your trainers and tasks you add will appear here.' %></p><% if (!totalCount) { %><a class="text-link" href="/student/tasks/new">Add a personal task</a><% } %></div><% } %>
</section>
<section class="settings-row"><div><h2>Deadline reminder window</h2><p>Choose how early an assignment should be flagged as coming up.</p></div><form class="inline-form" method="post" action="/student/settings"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><select name="remind_days"><% [[0,'Due date'],[1,'1 day before'],[2,'2 days before'],[3,'3 days before'],[7,'1 week before'],[14,'2 weeks before']].forEach(function(option) { %><option value="<%= option[0] %>" <%= user.remindDays === option[0] ? 'selected' : '' %>><%= option[1] %></option><% }) %></select><button class="button secondary" type="submit">Save</button></form></section>
<%- include('../partials/footer') %>