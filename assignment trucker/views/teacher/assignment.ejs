<%- include('../partials/header', { title: title }) %>
<p class="breadcrumb"><a href="/teacher">Trainer overview</a> / <a href="/teacher/courses/<%= assignment.course_id %>"><%= assignment.course_name %></a> / Tracking</p>
<section class="page-heading"><div><p class="eyebrow"><%= assignment.course_name %> · Due <%= fmt.pretty(assignment.due_on) %></p><h1><%= assignment.title %></h1><p class="muted"><%= assignment.description || 'No additional instructions.' %></p></div><a class="button secondary" href="/teacher/assignments/<%= assignment.id %>/export.csv">Download CSV</a></section>
<section class="stat-strip compact"><div><strong><%= students.length %></strong><span>Enrolled</span></div><div><strong><%= students.filter(function(s) { return s.submitted_at; }).length %></strong><span>Handed in</span></div><div><strong><%= students.filter(function(s) { return !s.submitted_at && String(s.due_on || assignment.due_on).slice(0,10) < fmt.toISO(new Date()); }).length %></strong><span>Late</span></div><div><strong><%= assignment.max_marks || '—' %></strong><span>Maximum marks</span></div></section>
<div class="section-title"><div><p class="eyebrow">Class progress</p><h2>Student submissions</h2></div><form method="post" action="/teacher/assignments/<%= assignment.id %>/remind"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button secondary" type="submit">Remind outstanding students</button></form></div>
<% if (students.length) { %><div class="submission-list"><% students.forEach(function(student) { %><article class="submission-card"><div class="submission-person"><strong><%= student.full_name %></strong><span><%= student.student_no %> · <%= student.email %></span><span class="pill <%= student.submitted_at ? 'green' : student.status === 'In Progress' ? 'blue' : 'gold' %>"><%= student.submitted_at ? 'Handed in ' + fmt.pretty(student.submitted_at) : (student.status || 'Not Started') %></span></div><div class="submission-work"><strong>Work link or note</strong><p><%= student.work_note || 'No work handed in.' %></p></div><form class="mark-form" method="post" action="/teacher/assignments/<%= assignment.id %>/marks"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="student_id" value="<%= student.id %>"><label>Mark<input type="number" name="marks" min="0" max="<%= assignment.max_marks || 10000 %>" value="<%= student.marks === null ? '' : student.marks %>"></label><label>Feedback<input name="feedback" maxlength="500" value="<%= student.feedback || '' %>" placeholder="Feedback"></label><button class="button secondary" type="submit">Save feedback</button></form></article><% }) %></div><% } else { %><div class="empty-state"><h3>No students are enrolled</h3><p>Add students from the course roster before tracking submissions.</p><a class="text-link" href="/teacher/courses/<%= assignment.course_id %>">Open course roster</a></div><% } %>
<%- include('../partials/footer') %>