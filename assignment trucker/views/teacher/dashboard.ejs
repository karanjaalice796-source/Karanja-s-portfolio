<%- include('../partials/header', { title: title }) %>
<section class="page-heading"><div><p class="eyebrow">Trainer workspace</p><h1>Course overview</h1><p class="muted">Publish work once, then follow each class through to hand-in.</p></div><a class="button primary" href="/teacher/assignments/new">Post assignment</a></section>
<section class="section-block"><div class="section-title"><div><p class="eyebrow">Your teaching</p><h2>Courses</h2></div></div>
<% if (courses.length) { %><div class="course-grid"><% courses.forEach(function(course) { %><a class="course-card" href="/teacher/courses/<%= course.id %>"><span class="course-code"><%= course.code || 'COURSE' %></span><h3><%= course.name %></h3><div class="card-metrics"><span><strong><%= course.students %></strong> students</span><span><strong><%= course.assignments %></strong> assignments</span></div><span class="card-link">Open course →</span></a><% }) %></div><% } else { %><div class="empty-state"><h3>No courses assigned yet</h3><p>Ask an administrator to assign a course to your trainer account.</p></div><% } %></section>
<section class="section-block"><div class="section-title"><div><p class="eyebrow">Recently posted</p><h2>Assignments</h2></div></div>
<% if (recent.length) { %><div class="table-wrap"><table><thead><tr><th>Assignment</th><th>Course</th><th>Due</th><th>Handed in</th><th></th></tr></thead><tbody><% recent.forEach(function(row) { %><tr><td><a href="/teacher/assignments/<%= row.id %>"><strong><%= row.title %></strong></a></td><td><%= row.course_name %></td><td><%= fmt.pretty(row.due_on) %></td><td><%= row.handed_in %> / <%= row.students %></td><td><a class="text-link" href="/teacher/assignments/<%= row.id %>">Track →</a></td></tr><% }) %></tbody></table></div><% } else { %><p class="muted">Assignments you post will appear here.</p><% } %></section>
<%- include('../partials/footer') %>