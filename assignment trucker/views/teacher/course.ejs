<%- include('../partials/header', { title: title }) %>
<p class="breadcrumb"><a href="/teacher">Trainer overview</a> / Course</p>
<section class="page-heading"><div><p class="eyebrow"><%= course.code || 'Course' %></p><h1><%= course.name %></h1><p class="muted"><%= students.length %> enrolled students · <%= assignments.length %> assignments</p></div><a class="button primary" href="/teacher/assignments/new?course=<%= course.id %>">Post assignment</a></section>
<section class="section-block"><div class="section-title"><div><p class="eyebrow">Coursework</p><h2>Assignments</h2></div></div>
<% if (assignments.length) { %><div class="table-wrap"><table><thead><tr><th>Title</th><th>Due</th><th>Handed in</th><th>Marks</th></tr></thead><tbody><% assignments.forEach(function(a) { %><tr><td><a href="/teacher/assignments/<%= a.id %>"><strong><%= a.title %></strong></a></td><td><%= fmt.pretty(a.due_on) %></td><td><%= a.handed_in %> / <%= students.length %></td><td><%= a.max_marks || '—' %></td></tr><% }) %></tbody></table></div><% } else { %><p class="muted">No assignments posted to this course yet.</p><% } %></section>
<section class="section-block"><div class="section-title"><div><p class="eyebrow">Course roster</p><h2>Students</h2></div></div>
<form class="inline-form roster-add" method="post" action="/teacher/courses/<%= course.id %>/students"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label for="studentLookup">Add by email or student number</label><input id="studentLookup" name="student" maxlength="150" required placeholder="student@example.com or ID"><button class="button secondary" type="submit">Add student</button></form>
<% if (students.length) { %><div class="table-wrap"><table><thead><tr><th>Name</th><th>Student number</th><th>Email</th><th></th></tr></thead><tbody><% students.forEach(function(student) { %><tr><td><strong><%= student.full_name %></strong></td><td><%= student.student_no %></td><td><%= student.email %></td><td><form method="post" action="/teacher/courses/<%= course.id %>/students/<%= student.id %>/remove"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="text-button danger-text" type="submit">Remove</button></form></td></tr><% }) %></tbody></table></div><% } else { %><p class="muted">No students enrolled yet.</p><% } %></section>
<%- include('../partials/footer') %>