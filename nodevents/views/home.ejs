<%- include('partials/head', { title: 'Nodevents · Event Planner' }) %>
<section class="site-home-hero">
  <p class="eyebrow">Plan together, without the loose ends</p>
  <h1>Make every event easier to bring together.</h1>
  <p class="intro">Explore event ideas, find participating vendors, and coordinate invitations, schedules, attendance, and budgets in one place.</p>
  <div class="site-home-actions">
    <a class="button primary" href="/browse-events">Browse event types</a>
