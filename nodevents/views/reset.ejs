<%- include('partials/head', { title: 'Choose a new password' }) %>
<section class="auth-container">
  <p class="eyebrow">Planner account access</p>
  <h1 class="auth-heading">Choose a new password</h1>
  <p class="auth-intro">Use a password between 8 and 128 characters.</p>
  <% if (error) { %><p class="error" role="alert"><%= error %></p><% } %>
  <form class="auth-form" method="post" action="/auth/reset/<%= token %>">
    <label class="auth-field">New password
      <input class="auth-input" type="password" name="password" autocomplete="new-password" minlength="8" maxlength="128" required>
    </label>
    <label class="auth-field">Confirm new password
      <input class="auth-input" type="password" name="confirm" autocomplete="new-password" minlength="8" maxlength="128" required>
    </label>
    <button class="login-button" type="submit">Update password</button>
  </form>
</section>
<%- include('partials/foot') %>
