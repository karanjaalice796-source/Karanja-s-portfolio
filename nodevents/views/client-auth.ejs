<%- include('partials/head', { title }) %>
<section class="auth-container client-auth">
  <p class="eyebrow">Nodevents client account</p>
  <h1 class="auth-heading"><%= authMode === 'register' ? 'Create your client account' : 'Client sign in' %></h1>
  <p class="auth-intro">Keep your event requests, plans and conversations with planners together.</p>
  <% if (loggedOut) { %><p class="flash auth-logout-notice" role="status">You've been logged out.</p><% } %>
  <% if (error) { %><p class="error" role="alert"><%= error %></p><% } %>
  <div class="auth-tabs" role="tablist" aria-label="Client account options">
    <a class="auth-tab <%= authMode === 'login' ? 'active' : '' %>" href="/client/auth?mode=login" role="tab" aria-selected="<%= authMode === 'login' %>">Sign in</a>
    <a class="auth-tab <%= authMode === 'register' ? 'active' : '' %>" href="/client/auth?mode=register" role="tab" aria-selected="<%= authMode === 'register' %>">Create account</a>
  </div>
  <% if (authMode === 'register') { %>
    <form class="auth-form" method="post" action="/client/register">
      <label class="auth-field">Your name<input class="auth-input" name="name" autocomplete="name" maxlength="80" required></label>
      <label class="auth-field">Email<input class="auth-input" type="email" name="email" autocomplete="email" maxlength="160" required></label>
      <label class="auth-field">Phone (optional)<input class="auth-input" type="tel" name="phone" autocomplete="tel" maxlength="40"></label>
      <label class="auth-field">Password <small>8–128 characters</small><input class="auth-input" type="password" name="password" autocomplete="new-password" minlength="8" maxlength="128" required></label>
      <button class="login-button secondary-login-button" type="submit">Create client account</button>
    </form>
  <% } else { %>
    <form class="auth-form" method="post" action="/client/login">
      <label class="auth-field">Email<input class="auth-input" type="email" name="email" autocomplete="email" maxlength="160" autofocus required></label>
      <label class="auth-field">Password<input class="auth-input" type="password" name="password" autocomplete="current-password" maxlength="128" required></label>
      <button class="login-button" type="submit">Sign in to your client dashboard</button>
    </form>
  <% } %>
  <p class="auth-recovery-link"><a href="/auth">Planner sign in</a> · <a href="/client/access">Open a private event link</a></p>
</section>
<%- include('partials/foot') %>
