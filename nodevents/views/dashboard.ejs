<%- include('partials/head', { title: 'Planner dashboard' }) %>
<%
  const money = (amount) => `KES ${Number(amount || 0).toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
  const tones = {
    wedding: 'coral',
    birthday: 'saffron',
    graduation: 'teal',
    corporate: 'plum',
    'baby-family': 'saffron',
    religious: 'plum',
    entertainment: 'coral',
    education: 'teal',
    sports: 'teal',
    'private-gathering': 'sand',
    community: 'plum',
    'business-promotion': 'saffron',
    other: 'sand',
  };
  const upcomingEvents = events.filter((event) => !event.isPast);
  const pastEvents = events.filter((event) => event.isPast);
  const summary = {
    upcoming: upcomingEvents.length,
    vendors: events.reduce((total, event) => total + Number(event.vendor_count), 0),
    replied: events.reduce((total, event) => total + Number(event.replied_count), 0),
    awaiting: events.reduce((total, event) => total + Number(event.pending_count), 0),
  };
  const attentionEvents = upcomingEvents.filter((event) => Number(event.pending_count) > 0).slice(0, 4);
%>
<div class="dash">
  <section class="d-hero" id="overview">
    <div>
      <p class="eyebrow">Planner dashboard</p>
      <h1>Your events, all in one place</h1>
      <p class="d-sub">Keep dates and vendor confirmations in view as your plans come together.</p>
    </div>
    <a class="button primary" href="#new">＋ New event</a>
  </section>

  <nav class="planner-portal-links panel" aria-label="Planner dashboard sections">
    <a href="#overview">Overview and analytics</a>
    <a href="#client-event-requests">Client Event Requests</a>
    <a href="#my-events">My Events</a>
    <a href="/clients">Client Management</a>
    <a href="<%= events.length ? `/events/${events[0].id}/logistics` : '/vendors' %>">Vendor Management</a>
    <a href="#bookings">Bookings</a>
    <a href="<%= events.length ? `/events/${events[0].id}/budget` : '#new' %>">Budget and Expenses</a>
    <a href="<%= events.length ? `/events/${events[0].id}#invoices` : '#new' %>">Payments and Invoices</a>
    <a href="<%= events.length ? `/events/${events[0].id}/logistics` : '#new' %>">Tasks and Schedules</a>
    <a href="<%= events.length ? `/events/${events[0].id}/reports` : '#new' %>">Reports</a>
    <a href="#messages">Messages</a>
    <a href="#settings">Settings</a>
  </nav>

  <details class="d-new" id="new">
    <summary><span class="plus" aria-hidden="true">+</span>Create an event<span class="d-hint">Add the date, venue, and event type</span></summary>
    <form class="d-form" method="post" action="/events">
      <label>Event name<input name="title" maxlength="120" placeholder="e.g. Maya & Jordan's wedding" required></label>
      <label>Date<input type="date" name="event_date" required></label>
      <label>Venue<input name="venue" maxlength="160" placeholder="Venue or location"></label>
      <label>Event type
        <select name="event_type" required>
          <option value="other" <%= selectedEventType === 'other' ? 'selected' : '' %>>Other (blank event)</option>
          <% Object.entries(templates).forEach(([key, template]) => { %><option value="<%= key %>" <%= selectedEventType === key ? 'selected' : '' %>><%= template.label %></option><% }) %>
        </select>
      </label>
      <label class="wide-field">Venue and arrival notes<textarea name="venue_notes" maxlength="1000" placeholder="Entrance, loading area, parking, or access details"></textarea></label>
      <button class="primary" type="submit">Create event</button>
    </form>
  </details>

  <section class="panel" id="client-event-requests">
    <h2>Client Event Requests</h2>
    <p class="muted">Review new requests separately from events that are already approved and being planned.</p>
    <% if (clientRequests.length) { %>
      <div class="table-wrap">
        <table>
          <thead><tr><th>Client and request</th><th>Preferred date</th><th>Estimated budget</th><th>Status</th><th>Review actions</th></tr></thead>
          <tbody>
            <% clientRequests.forEach((item) => { %>
              <tr>
                <td>
                  <strong><%= item.title %></strong><br>
                  <span class="muted"><%= item.client_name %><%= item.client_organization ? ` · ${item.client_organization}` : '' %></span><br>
                  <span class="muted"><%= templates[item.event_type]?.label || 'Other' %><%= item.venue ? ` · ${item.venue}` : '' %></span>
                  <% if (item.details) { %><br><span><%= item.details %></span><% } %>
                </td>
                <td><%= item.desired_date || 'To be confirmed' %></td>
                <td>KES <%= Number(item.estimated_budget).toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></td>
                <td><%= item.status.replace('_', ' ') %><% if (item.decision_reason) { %><br><span class="muted"><%= item.decision_reason %></span><% } %></td>
                <td>
                  <% if (item.status === 'pending') { %>
                    <form method="post" action="/client-requests/<%= item.id %>/decision" class="form-grid">
                      <input type="hidden" name="decision" value="approve">
                      <label>Event date<input type="date" name="event_date" value="<%= item.desired_date %>" required></label>
                      <button class="primary" type="submit">Approve and create event</button>
                    </form>
                    <details>
                      <summary>Reject request</summary>
                      <form method="post" action="/client-requests/<%= item.id %>/decision">
                        <input type="hidden" name="decision" value="reject">
                        <label>Reason<textarea name="reason" maxlength="2000" rows="2" required></textarea></label>
                        <button class="button" type="submit">Reject with reason</button>
                      </form>
                    </details>
                    <details>
                      <summary>Request changes</summary>
                      <form method="post" action="/client-requests/<%= item.id %>/decision">
                        <input type="hidden" name="decision" value="request_changes">
                        <label>What should the client change?<textarea name="reason" maxlength="2000" rows="2" required></textarea></label>
                        <button class="button" type="submit">Ask for changes</button>
                      </form>
                    </details>
                  <% } else { %>
                    <span class="muted">Waiting for the client to update and resubmit.</span>
                  <% } %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <p class="muted">No event requests are waiting for review.</p>
    <% } %>
  </section>

  <section class="panel" id="bookings">
    <h2>Vendor Booking Requests</h2>
    <p class="muted">Review vendor bookings requested by your clients. Accepting adds the vendor to the event and sends an invitation; declining requires a reason.</p>
    <% if (bookingRequests.length) { %>
      <div class="table-wrap">
        <table>
          <thead><tr><th>Client and event</th><th>Vendor</th><th>Requested details</th><th>Actions</th></tr></thead>
          <tbody><% bookingRequests.forEach((booking) => { %>
            <tr>
              <td><strong><%= booking.client_name %></strong><br><a href="/events/<%= booking.event_id %>"><%= booking.event_title %></a><br><span class="muted"><%= booking.event_date %></span></td>
              <td><%= booking.business_name %><br><span class="muted"><%= booking.category %></span></td>
              <td><%= booking.message || 'No additional notes.' %></td>
              <td>
                <form method="post" action="/client-vendor-bookings/<%= booking.id %>/decision">
                  <input type="hidden" name="decision" value="accept">
                  <button class="primary" type="submit">Accept and invite</button>
                </form>
                <details>
                  <summary>Decline request</summary>
                  <form method="post" action="/client-vendor-bookings/<%= booking.id %>/decision">
                    <input type="hidden" name="decision" value="decline">
                    <label>Reason<textarea name="reason" maxlength="1000" rows="2" required></textarea></label>
                    <button type="submit">Decline with reason</button>
                  </form>
                </details>
              </td>
            </tr>
          <% }) %></tbody>
        </table>
      </div>
    <% } else { %><p class="muted">No vendor booking requests are waiting for review.</p><% } %>
  </section>

  <section class="panel" id="messages">
    <h2>Client messages</h2>
    <p class="muted">Recent client portal messages and email communication for your workspace.</p>
    <% if (plannerMessages.length) { %>
      <div class="table-wrap">
        <table>
          <thead><tr><th>Date</th><th>Client</th><th>Event</th><th>Channel</th><th>Message</th><th></th></tr></thead>
          <tbody><% plannerMessages.forEach((message) => { %>
            <tr>
              <td><%= message.created_at %></td>
              <td><%= message.client_name %></td>
              <td><%= message.event_title || 'General' %></td>
              <td><%= message.channel %><%= message.delivery_status === 'failed' ? ' · email delivery failed' : '' %></td>
              <td><%= message.message %></td>
              <td><a href="/clients/<%= message.client_id %>">Open conversation</a></td>
            </tr>
          <% }) %></tbody>
        </table>
      </div>
    <% } else { %><p class="muted">Client messages will appear here.</p><% } %>
  </section>

  <ul class="d-stats" aria-label="Event and vendor summary">
    <li class="d-stat tone-coral">
      <span class="d-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="16" rx="2"></rect><path d="M16 3v4M8 3v4M3 10h18"></path></svg></span>
      <strong data-count="<%= summary.upcoming %>"><%= summary.upcoming %></strong><span>Upcoming events</span>
    </li>
    <li class="d-stat tone-saffron">
      <span class="d-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="9" cy="8" r="3"></circle><path d="M3 20v-1a6 6 0 0 1 12 0v1M16 5a3 3 0 0 1 0 6m2 3a5 5 0 0 1 3 5v1"></path></svg></span>
      <strong data-count="<%= summary.vendors %>"><%= summary.vendors %></strong><span>Vendors invited</span>
    </li>
    <li class="d-stat tone-teal">
      <span class="d-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m5 12 4 4L19 6"></path><circle cx="12" cy="12" r="10"></circle></svg></span>
      <strong data-count="<%= summary.replied %>"><%= summary.replied %></strong><span>Vendor replies received</span>
    </li>
    <li class="d-stat tone-plum">
      <span class="d-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"></circle><path d="M12 6v6l4 2"></path></svg></span>
      <strong data-count="<%= summary.awaiting %>"><%= summary.awaiting %></strong><span>Awaiting a reply</span>
    </li>
  </ul>

  <ul class="d-stats planner-finance-stats" aria-label="Planner work summary">
    <li class="d-stat tone-coral"><strong><%= plannerFinance.open_tasks %></strong><span>Open planning tasks</span></li>
    <li class="d-stat tone-saffron"><strong><%= money(plannerFinance.actual_expenses) %></strong><span>Recorded expenses</span></li>
    <li class="d-stat tone-plum"><strong><%= money(plannerFinance.outstanding_invoices) %></strong><span>Outstanding vendor invoices</span></li>
  </ul>

  <div class="d-main">
    <div>
      <h2 class="d-section" id="my-events">My Events · Coming up</h2>
      <% if (upcomingEvents.length) { %>
        <div class="d-list">
          <% upcomingEvents.forEach((event) => {
            const eventDate = new Date(`${event.event_date}T12:00:00`);
            const tone = tones[event.event_type] || 'sand';
            const confirmedPercent = event.vendor_count ? Math.round((Number(event.confirmed_count) / Number(event.vendor_count)) * 100) : 0;
            const pendingPercent = event.vendor_count ? Math.round((Number(event.pending_count) / Number(event.vendor_count)) * 100) : 0;
            const when = event.daysUntil === 0 ? 'Today' : event.daysUntil === 1 ? 'Tomorrow' : `In ${event.daysUntil} days`;
          %>
            <article class="d-card tone-<%= tone %>">
              <a class="d-stretch" href="/events/<%= event.id %>" aria-label="Open <%= event.title %>"></a>
              <time class="d-date" datetime="<%= event.event_date %>">
                <span><%= eventDate.toLocaleDateString(undefined, { month: 'short' }) %></span>
                <strong><%= eventDate.getDate() %></strong>
              </time>
              <div>
                <div class="d-top">
                  <span class="d-chip"><%= templates[event.event_type]?.label || 'Other' %></span>
                  <span class="d-when <%= event.daysUntil <= 7 ? 'soon' : '' %>"><%= when %></span>
                </div>
                <h2><%= event.title %></h2>
                <p class="d-meta"><%= eventDate.toLocaleDateString(undefined, { weekday: 'long', month: 'long', day: 'numeric', year: 'numeric' }) %> · <%= event.venue || 'Venue to be confirmed' %></p>
                <p class="d-guests"><strong><%= event.vendor_count %></strong> vendors invited · <strong><%= event.pending_count %></strong> awaiting reply</p>
                <div class="d-bars">
                  <div>
                    <div class="d-bar-label"><span>Confirmed</span><strong><%= event.confirmed_count %> of <%= event.vendor_count %></strong></div>
                    <div class="meter" role="progressbar" aria-label="Vendor confirmations" aria-valuemin="0" aria-valuemax="100" aria-valuenow="<%= confirmedPercent %>"><span style="width: <%= confirmedPercent %>%"></span></div>
                  </div>
                  <div>
                    <div class="d-bar-label"><span>Awaiting reply</span><strong><%= event.pending_count %></strong></div>
                    <div class="meter pending-meter" role="progressbar" aria-label="Vendors awaiting reply" aria-valuemin="0" aria-valuemax="100" aria-valuenow="<%= pendingPercent %>"><span style="width: <%= pendingPercent %>%"></span></div>
                  </div>
                </div>
              </div>
            </article>
          <% }) %>
        </div>
      <% } else { %>
        <section class="d-empty">
          <div class="d-art" aria-hidden="true"><span></span><span></span><span></span></div>
          <h2>No upcoming events yet</h2>
          <p>Create an event to start organizing dates and vendor replies in one place.</p>
        </section>
      <% } %>

      <% if (pastEvents.length) { %>
        <details class="d-past">
          <summary>Past events (<%= pastEvents.length %>)</summary>
          <ul class="plain">
            <% pastEvents.forEach((event) => { %>
              <li><a href="/events/<%= event.id %>"><strong><%= event.title %></strong></a><span class="muted"><%= new Date(`${event.event_date}T12:00:00`).toLocaleDateString(undefined, { dateStyle: 'medium' }) %></span></li>
            <% }) %>
          </ul>
        </details>
      <% } %>
    </div>

    <aside class="d-side">
      <section class="d-attn">
        <h2>Vendor replies</h2>
        <% if (attentionEvents.length) { %>
          <p class="muted">These upcoming events still have vendors to hear from.</p>
          <ul class="plain">
            <% attentionEvents.forEach((event) => { %>
              <li class="<%= event.daysUntil <= 7 ? 'lvl-soon' : '' %>">
                <a href="/events/<%= event.id %>"><strong><%= event.title %></strong></a><br>
                <span class="muted"><%= event.pending_count %> awaiting reply · <%= event.daysUntil === 0 ? 'today' : event.daysUntil === 1 ? 'tomorrow' : `in ${event.daysUntil} days` %></span>
              </li>
            <% }) %>
          </ul>
        <% } else { %>
          <p class="muted">No pending vendor replies for upcoming events. You’re all caught up.</p>
        <% } %>
      </section>
    </aside>
  </div>
</div>
<section class="panel planner-settings" id="settings">
  <h2>Planner settings</h2>
  <p>Your workspace uses <strong><%= user.email %></strong> as its sign-in address.</p>
  <p class="muted">Update your account password from the <a href="/auth">planner sign-in page</a> or manage your Nodevents subscription in <a href="/plans">Plans and payments</a>.</p>
</section>
<script src="/dashboard.js" defer></script>
<%- include('partials/foot') %>
