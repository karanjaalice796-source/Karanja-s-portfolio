<%- include('partials/head', { title }) %>
<section class="auth-container">
  <p class="eyebrow">Client portal invitation</p>
  <h1 class="auth-heading">Create your Nodevents account</h1>
  <p class="auth-intro"><strong><%= clientRecord.planner_name %></strong> invited <strong><%= clientRecord.email %></strong> to view the planning workspace for <strong><%= clientRecord.name %></strong>.</p>
  <% if (error) { %><p class="error" role="alert"><%= error %></p><% } %>
  <form class="auth-form" method="post" action="/client/invite/<%= token %>">
    <label class="auth-field">Password <small>(8–128 characters)</small>
      <input class="auth-input" type="password" name="password" autocomplete="new-password" minlength="8" maxlength="128" required>
    </label>
    <label class="auth-field">Confirm password
      <input class="auth-input" type="password" name="confirm_password" autocomplete="new-password" minlength="8" maxlength="128" required>
    </label>
    <button class="login-button secondary-login-button" type="submit">Create client account</button>
  </form>
</section>
<%- include('partials/foot') %>
