NODE_ENV=development
PORT=3100
APP_BASE_URL=http://localhost:3100
SESSION_SECRET=replace-with-a-long-random-secret
GOOGLE_MAPS_ROUTES_API_KEY=

# M-Pesa Daraja Sandbox credentials (see the README for callback setup)
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_SHORT_CODE=
MPESA_CALLBACK_TOKEN=
MPESA_CALLBACK_URL=

# Google OAuth web application credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple Sign in with Apple credentials
# APPLE_CLIENT_ID is your Sign in with Apple Services ID.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Paste the complete .p8 key here, keeping the \n line breaks.
APPLE_PRIVATE_KEY=

# SMTP is optional for local demos. Without SMTP_HOST, email is printed to the server console.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Nodevents <no-reply@example.com>"

# Automatic reminders for pending vendors.
REMINDER_HOURS=48
MAX_REMINDERS=3
REMINDER_CHECK_MINUTES=60

# Vendor links remain active through this many days after the event date.
LINK_GRACE_DAYS=30
