MAIL_FROM="Nodevents <no-reply@example.com>"

# Automatic reminders for pending vendors.
REMINDER_HOURS=48
MAX_REMINDERS=3
REMINDER_CHECK_MINUTES=60

# Vendor links remain active through this many days after the event date.
LINK_GRACE_DAYS=30
